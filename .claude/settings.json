{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/block_main_edits.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git update-ref:*)",
      "Bash(rm:*)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "MultiEdit(scripts/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)"
    ],
    "ask": [
      "Bash(mvn deploy:*)",
      "Bash(mvn release:*)"
    ]
  }
}
